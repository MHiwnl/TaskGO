# O .\iniciar.ps1 cria o .env sozinho, com senha aleatória. Use este modelo só se quiser criar à mão.
# Senha do banco local (Docker). O git ignora o arquivo .env.
DB_PASSWORD=troque-por-uma-senha-forte
# Token do aviso de pagamento do simulador Pix para a API (o iniciar.ps1 gera um).
PIX_WEBHOOK_TOKEN=troque-por-um-token-aleatorio

# Pagamento: simulado (padrão) ou asaas.
TASKGO_PAGAMENTOS_MODO=simulado
# direto: o cliente paga quem atende (Pix na chave dele ou dinheiro), depois do serviço; pelo Asaas passa só a taxa da TaskGO (conta no CPF, sem CNPJ).
# retido: a TaskGO recebe o valor inteiro e repassa depois da confirmação (exige CNPJ).
TASKGO_PAGAMENTOS_MODELO=direto
# Asaas: chave da API (sandbox começa com $aact_hmlg_). Coloque entre aspas simples por causa do $.
ASAAS_API_KEY=''
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas manda no webhook (o mesmo cadastrado no painel do Asaas).
ASAAS_WEBHOOK_TOKEN=

# Administradores da moderação (e-mails separados por vírgula).
TASKGO_ADMIN_EMAILS=
# E-mail pelo Gmail: SMTP_USERNAME é o Gmail; SMTP_PASSWORD é a senha de app de 16 letras (não a senha normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Endereço da página de troca de senha que vai no e-mail. Em produção, troque pelo domínio com https.
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/#/recuperar
# Equipe de suporte: recebe os chamados de emergência em tempo real (e-mails separados por vírgula).
TASKGO_SUPORTE_EMAILS=
# Entrar com Google: ID do cliente OAuth do Google Cloud (Credenciais > ID do cliente OAuth > Aplicativo da Web).
GOOGLE_CLIENT_ID=

# SMS (desligado por padrão; cada SMS custa). desligado | log (só registra, para testar) | http (provedor):
# TASKGO_SMS_MODO=http
# TASKGO_SMS_URL=https://seu-provedor/enviar   (recebe POST JSON {"para":"+55...","texto":"..."})
# TASKGO_SMS_TOKEN=
